# 复制为 experiment.env 后按机器实际路径修改
# 建议在 PowerShell 中执行: Get-Content .\configs\experiment.env | ForEach-Object { if($_ -match '^\s*[^#].*=') { $k,$v = $_.Split('=',2); Set-Item -Path Env:$k -Value $v } }

PYTHON_EXE=python
DATASET_ROOT=/root/FPAA/dataset
DEFAULT_SEED=3407

# 训练方向: R2U 或 U2R
DEFAULT_DIRECTION=R2U

# 主干入口: MFNet 或 SAM_RS
DEFAULT_BACKBONE=MFNet

# 可选: 单独指定 LoveDA 根目录（默认会基于 DATASET_ROOT 推导）
LOVEDA_ROOT=/root/FPAA/dataset/LoveDA/Train
GLGAN_LOVEDA_ROOT=/root/FPAA/dataset/LoveDA/Train

# 可选: 覆盖数据集选择
MFNET_DATASET=Vaihingen
SAM_RS_DATASET=Urban

# 日志和结果目录
EXP_ROOT=E:/Alluserdata/RSS/SSRS/experiments/fpaa
